{
  // What makes this content "a game": title, campaign, look and rules.
  "titleKey": "game.title",
  "defaultLanguage": "fr",
  "fallbackLanguage": "en",
  "campaign": ["first_night"],
  "theme": "neon",
  "menuMusic": "music.action",
  "rules": {
    "friendlyFire": true,
    "unarmedWeaponId": "unarmed",
    "pickupRadius": 24,
    "pickupWhileArmed": "swap",
    "dropWeaponOnKnockdown": true,
    "dropWeaponOnDeath": true,
    "doorsKnockDown": true,
    "enemiesHaveInfiniteAmmo": true,
    "thrownHarmSpeed": 260,
    "execution": { "enabled": true, "range": 20, "durationMultiplier": 1, "cancelByMoving": true },
    "score": {
      "enabled": true,
      "comboWindow": 3,
      "points": { "melee": 400, "firearm": 300, "thrown": 600, "door": 800, "execution": 500 }
    }
  },
  "camera": {
    "viewHeight": 400,
    "zoom": 1,
    "followSharpness": 10,
    "lookAhead": 0.22,
    "lookAheadMax": 90,
    "farLook": 0.6,
    "farLookMax": 300,
    "shakeDecay": 4,
    "maxShake": 12
  },
  "sounds": {
    "uiMove": "sound.ui_move",
    "uiSelect": "sound.ui_select",
    "pickup": "sound.pickup",
    "throw": "sound.throw",
    "bounce": "sound.clank",
    "impact": "sound.clank",
    "footstep": "sound.footstep",
    "objectiveComplete": "sound.ui_select",
    "levelComplete": "sound.complete"
  }
}
