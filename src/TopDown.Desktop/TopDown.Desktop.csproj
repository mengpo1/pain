<Project Sdk="Microsoft.NET.Sdk">
  <!-- MonoGame front-end: window, rendering, audio, input. The game itself lives in the
       content folders; this executable only knows the engine rules. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TopDown.Desktop</RootNamespace>
    <AssemblyName>TopDown</AssemblyName>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <!-- Runtime TrueType fonts (MonoGame needs its content pipeline otherwise): lets themes and
         mods ship any .ttf and covers Unicode. -->
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TopDown.Core\TopDown.Core.csproj" />
    <ProjectReference Include="..\TopDown.Content\TopDown.Content.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Content and mods are plain files next to the executable: editable without recompiling. -->
    <None Include="..\..\Content\**\*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Mods\**\*" LinkBase="Mods" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
