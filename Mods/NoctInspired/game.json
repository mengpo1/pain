{
  // A different game on the same engine: only data changes.
  "titleKey": "noct.title",
  "campaign": ["outpost", "tunnels"],
  "theme": "thermal",
  "menuMusic": "music.dread",
  "rules": {
    "enemiesHaveInfiniteAmmo": false,
    "execution": { "durationMultiplier": 1.6 },
    "score": { "enabled": false }
  },
  // The action pack's quicker fall (0.05 s) and kill strobe, from its calibration on a reference video,
  // are not wanted here.
  "feel": { "fallDuration": 0.09, "kill": { "backdrop": 0 } },
  "camera": {
    "viewHeight": 340,
    "followSharpness": 5,
    "lookAhead": 0.12,
    "lookAheadMax": 60,
    "farLook": 0.45,
    "farLookMax": 220,
    "maxShake": 8
  },
  "sounds": {
    "levelComplete": "sound.static",
    "objectiveComplete": "sound.static"
  }
}
