{
  // Thermal surveillance feed: warm bodies glow, the world is cold and grainy.
  "id": "thermal",
  "background": "#050506",
  "tints": { "floor": "#ffffff", "wall": "#ffffff", "actor": "#ffffff", "weapon": "#ffffff", "decor": "#ffffff", "fx": "#ffffff", "blood": "#ffffff" },
  "shadow": { "enabled": false },
  "ui": {
    "font": "font.mono",
    "text": "#e6e6e6",
    "accent": "#ffffff",
    "secondary": "#b8b8b8",
    "danger": "#ffffff",
    "panel": "#000000c0",
    "shadow": "#000000",
    "hudStyle": "surveillance",
    "overlayLabelKey": "noct.camLabel",
    "titleWave": 0.15
  },
  "post": {
    "vignette": 0.5,
    "grain": 0.13,
    "scanlines": 0.2,
    "flicker": 0.6,
    "videoNoise": 0.5,
    "darkness": 0.45,
    "darknessColor": "#000000",
    "playerLightRadius": 240,
    "playerLightIntensity": 1.0,
    "muzzleFlashLight": 1.8,
    "colorMultiply": "#e8eef2",
    "hideUnseenActors": true
  }
}
