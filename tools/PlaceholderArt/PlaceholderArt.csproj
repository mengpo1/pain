<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the original placeholder art and sound for Content/Base and Mods/NoctInspired.
       Usage (from the repo root): dotnet run (project tools/PlaceholderArt), passing the repo root as argument.
       See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlaceholderArt</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
